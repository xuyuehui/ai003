root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ini,md,asmdef}]
indent_size = 2

[*.go]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf

[*.{csproj,vcxproj,props,targets}]
indent_size = 2

[*.{shader,hlsl,h,cpp,cs}]
indent_size = 4
