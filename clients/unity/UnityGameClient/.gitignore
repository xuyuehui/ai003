# ---------------------------------------------------------------------------
# Unity 6000.6 project (URP). Standard Unity ignore list.
#
# Tracked on purpose:
#   Assets/**            including every .meta file (Force Text serialization)
#   Packages/manifest.json, packages-lock.json
#   ProjectSettings/**   including ProjectVersion.txt
#   Assets/StreamingAssets/world/**  shared world data, regenerated by worldgen
# ---------------------------------------------------------------------------

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
[Ee]xportedObj/

# Never ignore .meta files: they bind assets to GUIDs used by scenes/prefabs.
!Assets/**/*.meta

# IDE / generated solution files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb

# Crash / dump files
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Local caches that can appear inside the project root
[Cc]rashlytics/
[Ll]ocal[Cc]aches/

# Editor screenshots / captured frames
Assets/Screenshots/

# Entities SubScene bake cache (generated)
Assets/SceneDependencyCache/
Assets/SceneDependencyCache.meta

# Generated bake meshes (scripts/bake-unity-terrain.cmd or AI003/Bake Tiled Streaming Terrain)
Assets/World/Baked/Meshes/
Assets/World/Baked/Tiles/Meshes/

# Baked scene data (regenerated by AI003/Bake Static Scene)
/Assets/Generated/
/Assets/Generated.meta
